<button class="toggle" id="themeToggle" aria-label="Toggle light and dark">Light</button>

<script>
/* Inject QR image via qrserver (no external libraries required) */
(function generateQR(){
  const container = document.getElementById('qrContainer');
  const url = location.href;
  const img = new Image();
  img.alt = "QR";
  img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' + encodeURIComponent(url);
  img.style.maxWidth='100%';
  img.style.height='auto';
  container.appendChild(img);
})();

/* Light/Dark toggle */
const toggle = document.getElementById('themeToggle');
function setTheme(t){
  if(t==='light'){ document.body.setAttribute('data-theme','light'); document.documentElement.style.setProperty('--bg-dark','#fff'); document.documentElement.style.setProperty('--text-dark','#111'); }
  else { document.body.setAttribute('data-theme','dark'); document.documentElement.style.setProperty('--bg-dark','#000'); document.documentElement.style.setProperty('--text-dark','#fff'); }
  toggle.textContent = (t==='light')? 'Dark' : 'Light';
  localStorage.setItem('siteTheme', t);
}
toggle.addEventListener('click', ()=> { const cur = document.body.getAttribute('data-theme') === 'light' ? 'dark' : 'light'; setTheme(cur); });
setTheme(localStorage.getItem('siteTheme')||'dark');

/* Improve WhatsApp button contrast in light mode */
const observer = new MutationObserver(()=> { 
  const isLight = document.body.getAttribute('data-theme') === 'light';
  if(isLight){ document.querySelectorAll('.btn.wa').forEach(b=> b.style.color='#fff'); }
});
observer.observe(document.body, { attributes: true });
</script>

<style>
:root{
  --bg-dark:#000;
  --bg-light:#fff;
  --text-dark:#fff;
  --text-light:#111;
  --muted-dark:#cfcfcf;
  --fb:#1877F2;
  --wa:#25D366;
  --gm:#D44638;
  --li:#0A66C2;
  --cv:#6c757d;
}
body{margin:0;font-family:Inter,Arial,Helvetica,sans-serif;background:var(--bg-dark);color:var(--text-dark);display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px}
[data-theme="light"]{background:var(--bg-light);color:var(--text-light)}
.card{width:100%;max-width:460px;background:transparent;text-align:center;padding:30px;border-radius:14px}
.avatar{width:170px;height:170px;border-radius:50%;object-fit:cover;margin:0 auto 18px;display:block;border:4px solid rgba(255,255,255,0.06)}
.name{font-size:20px;margin:6px 0 4px;font-weight:800;letter-spacing:0.3px}
.role{margin:0 0 16px;color:var(--muted-dark);font-weight:600}

/* Buttons container */
.btns{display:flex;flex-direction:column;gap:12px;align-items:center}

/* App-like rounded button */
.btn{display:flex;align-items:center;gap:14px;min-width:240px;padding:12px 16px;border-radius:999px;border:0;color:#fff;text-decoration:none;font-weight:700;box-shadow:0 10px 22px rgba(0,0,0,0.25);transform:translateY(0);transition:transform .25s ease, box-shadow .25s ease}
.icon-lg{width:32px;height:32px;flex:0 0 32px;display:inline-flex;align-items:center;justify-content:center}
.label{flex:1;text-align:left;font-size:15px}

/* Hover lift animation */
.btn:hover{transform:translateY(-8px);box-shadow:0 26px 40px rgba(0,0,0,0.35)}

/* Solid colors (official) */
.btn.li{background:var(--li)}
.btn.wa{background:var(--wa);color:#063c25}
.btn.fb{background:var(--fb)}
.btn.gm{background:var(--gm)}
.btn.cv{background:var(--cv)}

/* icons sizing */
.icon-lg svg{width:24px;height:24px;display:block}

/* Footer QR */
.footer{margin-top:20px;display:flex;gap:12px;align-items:center;justify-content:center;flex-direction:column}
.qr{width:110px;height:110px;padding:8px;background:transparent;border-radius:8px;display:flex;align-items:center;justify-content:center}
.small{font-size:12px;color:var(--muted-dark);margin-top:8px}

/* Responsive: row on wide screens */
@media(min-width:640px){ 
  .btns{flex-direction:row;flex-wrap:wrap;justify-content:center} 
  .btn{min-width:190px;margin:6px} 
  .label{text-align:center} 
}

/* Toggle button */
.toggle{position:fixed;top:16px;right:16px;background:transparent;border:2px solid rgba(255,255,255,0.12);padding:8px 12px;border-radius:999px;color:inherit;cursor:pointer;font-weight:700}
[data-theme="light"] .toggle{border-color:rgba(0,0,0,0.08)}

/* entrance */
@keyframes enter{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:none}}
.card,.btn{animation:enter .45s ease both}
</style>
</head>
